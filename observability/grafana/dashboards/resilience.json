{
  "uid": "event-platform-resilience",
  "title": "Event Platform - Resilience",
  "description": "Circuit breakers of the gateway (one per route) and of registration-service (calls to event-service), fallbacks and downstream calls.",
  "tags": [
    "event-platform"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Traces (Tempo)",
      "type": "link",
      "url": "/a/grafana-exploretraces-app/explore",
      "icon": "external link"
    },
    {
      "title": "Logs (Loki)",
      "type": "link",
      "url": "/a/grafana-lokiexplore-app/explore",
      "icon": "external link"
    },
    {
      "title": "Event Platform",
      "type": "dashboards",
      "tags": [
        "event-platform"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "Circuit breaker state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Closed: calls go through. Open: calls fail fast (fallback). Half-open: a few trial calls after the wait.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Half-open",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service_name}} -> {{name}}",
          "expr": "2 * max by (service_name, name) (resilience4j_circuitbreaker_state{state=\"open\"}) + max by (service_name, name) (resilience4j_circuitbreaker_state{state=\"half_open\"})"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Failure rate",
      "description": "Failed calls in the sliding window; the breaker opens above its threshold. -1 (not enough calls yet) is hidden.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "resilience4j_circuitbreaker_failure_rate >= 0",
          "legendFormat": "{{service_name}} -> {{name}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Calls rejected while open",
      "description": "Calls short-circuited by an open breaker: answered at once by the fallback.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total[$__rate_interval]))",
          "legendFormat": "{{service_name}} -> {{name}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Calls through the breakers",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, name, kind) (rate(resilience4j_circuitbreaker_calls_milliseconds_count[$__rate_interval]))",
          "legendFormat": "{{service_name}} -> {{name}} {{kind}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Gateway 5xx (fallbacks and timeouts)",
      "description": "503: route unavailable (fallback). 504: upstream timeout.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"api-gateway\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Downstream calls of registration-service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_name, outcome) (rate(http_client_requests_milliseconds_count{service_name=\"registration-service\"}[$__rate_interval]))",
          "legendFormat": "{{client_name}} {{outcome}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Downstream latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (client_name, le) (rate(http_client_requests_milliseconds_bucket{service_name=\"registration-service\"}[$__rate_interval])))",
          "legendFormat": "{{client_name}}"
        }
      ],
      "id": 7
    }
  ]
}
