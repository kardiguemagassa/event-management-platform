{
  "uid": "event-platform-business",
  "title": "Event Platform - Business",
  "description": "What the platform does for its users: registrations confirmed, cancelled and rejected (registration-service).",
  "tags": [
    "event-platform"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Traces (Tempo)",
      "type": "link",
      "url": "/a/grafana-exploretraces-app/explore",
      "icon": "external link"
    },
    {
      "title": "Logs (Loki)",
      "type": "link",
      "url": "/a/grafana-lokiexplore-app/explore",
      "icon": "external link"
    },
    {
      "title": "Event Platform",
      "type": "dashboards",
      "tags": [
        "event-platform"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Confirmed",
      "description": "Registrations confirmed over the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "expr": "sum(increase(registrations_confirmed_total{service_name=\"registration-service\"}[$__range])) or vector(0)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Cancelled",
      "description": "Registrations cancelled by their attendee over the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "expr": "sum(increase(registrations_cancelled_total{service_name=\"registration-service\"}[$__range])) or vector(0)"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Rejected",
      "description": "Registration attempts rejected over the time range (event full, already registered...).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "expr": "sum(increase(registrations_rejected_total{service_name=\"registration-service\"}[$__range])) or vector(0)"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Registrations per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum(rate(registrations_confirmed_total{service_name=\"registration-service\"}[$__rate_interval]))",
          "legendFormat": "confirmed"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum(rate(registrations_cancelled_total{service_name=\"registration-service\"}[$__rate_interval]))",
          "legendFormat": "cancelled"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Rejections by reason",
      "description": "Per minute. EVENT_FULL is demand above capacity; DOWNSTREAM_UNAVAILABLE an outage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * sum by (reason) (rate(registrations_rejected_total{service_name=\"registration-service\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 5
    }
  ]
}
