{
  "openapi": "3.0.1",
  "info": {
    "title": "Registration Service API",
    "description": "Registers the authenticated user to events of event-service. Errors follow RFC 9457 and carry a stable `code`.",
    "version": "0.0.0-SNAPSHOT"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "keycloak": []
    }
  ],
  "tags": [
    {
      "name": "Registrations",
      "description": "Register the authenticated user to events"
    }
  ],
  "paths": {
    "/api/registrations": {
      "post": {
        "tags": [
          "Registrations"
        ],
        "summary": "Register the caller to an event",
        "description": "Requires the ATTENDEE role. The seat is reserved asynchronously: the registration is PENDING, then CONFIRMED, or REJECTED with its rejectionReason (event full, closed or unknown). Follow it at the Location returned.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Registration requested, waiting for its seat (PENDING)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/registrations/{id}/cancel": {
      "post": {
        "tags": [
          "Registrations"
        ],
        "summary": "Cancel one of the caller's registrations",
        "description": "PENDING or CONFIRMED. Cancelled at once; its seat is released asynchronously.",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registration cancelled, seat being released",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/registrations/{id}": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "summary": "Get one of the caller's registrations",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registration found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/registrations/me": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "summary": "List the caller's registrations",
        "description": "Optionally for one event and in one status. Newest first: for one event, the first registration tells whether the caller is registered (PENDING or CONFIRMED).",
        "operationId": "mine",
        "parameters": [
          {
            "name": "eventId",
            "in": "query",
            "description": "Only the registrations to this event",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Only registrations in this status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "CONFIRMED",
                "REJECTED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page index (0..N)",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The size of the page to be returned",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "createdAt,DESC"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of registrations, newest first by default",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/registrations/events/{eventId}": {
      "get": {
        "tags": [
          "Registrations"
        ],
        "summary": "List the registrations of an event",
        "description": "Its organizer, or an administrator (audited). Each registration carries the attendee's display name (null when unknown: no profile, or names temporarily unavailable).",
        "operationId": "findByEvent",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Only registrations in this status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "CONFIRMED",
                "REJECTED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page index (0..N)",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The size of the page to be returned",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "createdAt,DESC"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of registrations, newest first by default",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseEventRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Conflict"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "example": 409
          },
          "detail": {
            "type": "string",
            "example": "Event 3f2b8c1e-\u2026 has no seat left"
          },
          "instance": {
            "type": "string",
            "example": "/api/registrations"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code",
            "example": "EVENT_FULL"
          }
        }
      },
      "RegistrationRequest": {
        "required": [
          "eventId"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "REJECTED",
              "CANCELLED"
            ]
          },
          "rejectionReason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageResponseRegistrationResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegistrationResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EventRegistrationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "attendeeName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "REJECTED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageResponseEventRegistrationResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventRegistrationResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request (validation, malformed JSON or id, invalid sort)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Bad Request",
              "status": 400,
              "detail": "Invalid request content.",
              "instance": "/api/registrations",
              "code": "VALIDATION_FAILED",
              "errors": {
                "eventId": "must not be null"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Event not found, or registration not found among the caller's own",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Not Found",
              "status": 404,
              "detail": "Registration 7c9e6679-\u2026 not found",
              "instance": "/api/registrations/7c9e6679-\u2026",
              "code": "REGISTRATION_NOT_FOUND"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Not the organizer of the event (NOT_EVENT_ORGANIZER)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Forbidden",
              "status": 403,
              "detail": "You are not the organizer of event 3f2b8c1e-\u2026",
              "instance": "/api/registrations/events/3f2b8c1e-\u2026",
              "code": "NOT_EVENT_ORGANIZER"
            }
          }
        }
      },
      "Conflict": {
        "description": "Business conflict (event full or not registrable, already registered, already cancelled, concurrent modification)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Conflict",
              "status": 409,
              "detail": "Event 3f2b8c1e-\u2026 is full",
              "instance": "/api/registrations",
              "code": "EVENT_FULL"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A dependent service is unavailable; the request can be retried",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Service Unavailable",
              "status": 503,
              "detail": "A dependent service is temporarily unavailable, please retry later",
              "instance": "/api/registrations",
              "code": "DOWNSTREAM_UNAVAILABLE"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired access token",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Unauthorized",
              "status": 401,
              "detail": "A valid access token is required",
              "instance": "/api/\u2026",
              "code": "UNAUTHENTICATED"
            }
          }
        }
      },
      "AccessDenied": {
        "description": "The caller's roles do not allow this operation",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "example": {
              "type": "about:blank",
              "title": "Forbidden",
              "status": 403,
              "detail": "You are not allowed to access this resource",
              "instance": "/api/\u2026",
              "code": "ACCESS_DENIED"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "keycloak": {
        "type": "oauth2",
        "description": "Keycloak sign-in (authorization code with PKCE)",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8180/realms/event-platform/protocol/openid-connect/auth",
            "tokenUrl": "http://localhost:8180/realms/event-platform/protocol/openid-connect/token",
            "scopes": {
              "openid": "OpenID Connect sign-in"
            }
          }
        }
      }
    }
  }
}
