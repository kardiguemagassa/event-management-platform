{
  "realm": "event-platform",
  "displayName": "Event Management Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "ATTENDEE",
        "description": "Registers to events; given to every new user"
      },
      {
        "name": "ORGANIZER",
        "description": "Creates, publishes and cancels events"
      },
      {
        "name": "SEAT_MANAGER",
        "description": "Technical role: reserves and releases seats (registration-service only)"
      },
      {
        "name": "PROFILE_READER",
        "description": "Technical role: reads the display names of users (registration-service only)"
      },
      {
        "name": "ADMIN",
        "description": "Administers the platform: reads and deletes any user profile"
      },
      {
        "name": "offline_access"
      },
      {
        "name": "uma_authorization"
      },
      {
        "name": "default-roles-event-platform",
        "composite": true,
        "composites": {
          "realm": [
            "ATTENDEE",
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-event-platform"
  },
  "clients": [
    {
      "clientId": "event-platform-web",
      "name": "Event platform web application",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "event-platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "event-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "event-platform-bff",
      "name": "Event platform BFF (API gateway)",
      "description": "Browser login through the gateway: confidential client, tokens kept server-side, session cookie only in the browser",
      "publicClient": false,
      "secret": "${BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:4200/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "event-platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "event-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles in the ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "registration-service",
      "name": "registration-service (service account)",
      "publicClient": false,
      "secret": "${REGISTRATION_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "event-platform-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "event-platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-registration-service",
      "enabled": true,
      "serviceAccountClientId": "registration-service",
      "realmRoles": [
        "SEAT_MANAGER",
        "PROFILE_READER"
      ]
    }
  ]
}
