# Local development only: copy to .env and set your own values
USER_DB_NAME=user_db
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me
USER_DB_PORT=5433

EVENT_DB_NAME=event_db
EVENT_DB_USERNAME=event_service
EVENT_DB_PASSWORD=change-me
EVENT_DB_PORT=5434

REGISTRATION_DB_NAME=registration_db
REGISTRATION_DB_USERNAME=registration_service
REGISTRATION_DB_PASSWORD=change-me
REGISTRATION_DB_PORT=5435

# Keycloak (identity provider): http://localhost:8180, realm "event-platform"
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=change-me
# Secret of the confidential client of registration-service (client credentials)
REGISTRATION_SERVICE_CLIENT_SECRET=change-me

# Observability: Grafana on http://localhost:3000 (admin / admin), traces sent over OTLP to localhost:4318
TRACING_SAMPLING_PROBABILITY=1.0
